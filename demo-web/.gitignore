# Node / Astro / Vite
node_modules/
.astro/
.vite/
dist/

# Regenerated by `npm run copy-assets` from node_modules — DO NOT commit
public/onnx/
public/mediapipe/wasm/

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env overrides
.env
.env.local
.env.*.local

# Override root .gitignore: we DO want to ship the trained ONNX models +
# the MediaPipe Face Landmarker .task file — they are required at runtime
# and there is no copy-assets step that produces them. Also un-ignore our
# `lib/` (root .gitignore blocks `lib/` for python build artifacts).
!lib/
!lib/**
!public/models/
!public/models/*.onnx
!public/mediapipe/face_landmarker.task
