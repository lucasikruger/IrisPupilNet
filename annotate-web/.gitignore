# Node / Astro / Vite
node_modules/
.astro/
.vite/
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/
.env/

# Regenerated by `npm run copy-assets` from node_modules — DO NOT commit
frontend/public/onnx/
frontend/public/mediapipe/wasm/

# Runtime DB / storage
*.db
*.db-journal
storage/
data/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*

# Local env overrides
.env
.env.local
.env.*.local

# Override root .gitignore: ship the trained ONNX models + the MediaPipe
# Face Landmarker .task file (runtime-required), and our lib/ folder
# (root .gitignore blocks `lib/` for python build artifacts).
!lib/
!lib/**
!frontend/lib/
!frontend/lib/**
!frontend/public/models/
!frontend/public/models/*.onnx
!frontend/public/mediapipe/face_landmarker.task
